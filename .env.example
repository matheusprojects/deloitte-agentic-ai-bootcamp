# Provedor e modelo do LLM (usados por src/utils/llm_adapter.py via init_chat_model)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Chave da API do provedor configurado acima
OPENAI_API_KEY=your_openai_api_key_here
# Opcional: endpoint alternativo compatível com a API da OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1

# Observabilidade com Langfuse (opcional: sem as chaves, o tracing fica desativado)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
